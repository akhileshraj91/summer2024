    "def get_data_dir(subfolder):\n",
    "    current_dir = os.getcwd()\n",
    "    print(current_dir)\n",
    "    return os.path.join(current_dir, \"experiment_data\", f\"{subfolder}\")\n"
   ]
  },
  {
