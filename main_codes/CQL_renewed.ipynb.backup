   "source": [
    "# Define the CSV file path\n",
    "csv_file_path = f'{DATA_DIR}/training_dataset.csv'\n",
    "\n",
    "# Load the CSV into a DataFrame\n",
    "loaded_data = pd.read_csv(csv_file_path)\n",
    "print(len(loaded_data))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 300,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
